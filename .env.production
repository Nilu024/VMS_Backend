# Production Environment Variables
PORT=5000
NODE_ENV=production

# Replace with your production MongoDB URI (MongoDB Atlas recommended)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/visitors_management?retryWrites=true&w=majority

# Generate a strong random secret for production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_123456789

# Your deployed frontend URL (for CORS)
FRONTEND_URL=https://yourdomain.com